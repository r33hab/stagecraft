---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>One Night of Light · not found</title><meta name="description" content="That page is not part of the night. Back to dusk." /><link rel="stylesheet" href={`${base}/_astro/404.css`} onerror="this.remove()" /></head>
<body style="margin:0;background:#06070d;color:#f1ede3;font-family:Georgia,serif;display:grid;place-items:center;min-height:100svh;text-align:center;padding:2rem">
<main id="main"><h1 style="font-weight:400;font-size:clamp(2rem,8vw,5rem);line-height:1">Not part of the night.</h1><p style="margin:1rem 0 2rem">That page does not exist.</p><a href={`${base}/`} style="color:#5ff09a">Back to dusk</a></main>
</body></html>
