---
// Code-drawn miniatures of each project's interface. No photography exists for a fictional studio,
// so the previews are the work itself, reduced to a glance.
interface Props { kind: string; accent: string; title: string }
const { kind, accent, title } = Astro.props;
---
<figure class="tile" data-kind={kind} style={`--pa:${accent}`} aria-label={`${title} preview`} role="img">
  {kind === 'receipt' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      <rect x="10" y="10" width="4" height="100" fill="var(--pa)" />
      {[0, 1, 2, 3, 4].map((i) => <g><rect x="24" y={16 + i * 19} width={60 + (i % 3) * 14} height="6" rx="3" fill="var(--tile-fg)" opacity=".85" /><rect x="118" y={16 + i * 19} width="32" height="6" rx="3" fill="var(--tile-fg)" opacity=".45" /><rect x="20" y={14 + i * 19} width="2" height="10" fill="var(--pa)" opacity={i === 2 ? 1 : 0.35} /></g>)}
    </svg>
  )}
  {kind === 'route' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      <path d="M14 96 C 40 92, 46 60, 72 58 S 110 70, 128 40 S 146 24, 150 18" fill="none" stroke="var(--tile-fg)" stroke-opacity=".25" stroke-width="6" stroke-linecap="round" />
      <path class="tile__dash" d="M14 96 C 40 92, 46 60, 72 58 S 110 70, 128 40 S 146 24, 150 18" fill="none" stroke="var(--pa)" stroke-width="6" stroke-linecap="round" />
      <circle cx="14" cy="96" r="6" fill="var(--pa)" /><circle cx="150" cy="18" r="6" fill="var(--tile-fg)" />
    </svg>
  )}
  {kind === 'configurator' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      <rect x="14" y="14" width="88" height="92" rx="10" fill="var(--pa)" opacity=".9" />
      <rect x="30" y="30" width="56" height="60" rx="6" fill="var(--tile-bg)" opacity=".35" />
      {['#2a9d8f', '#15161a', '#c98a2e', '#e4572e'].map((c, i) => <circle cx="124" cy={26 + i * 24} r="8" fill={c} stroke="var(--tile-fg)" stroke-opacity={i === 0 ? 1 : 0} stroke-width="3" />)}
    </svg>
  )}
  {kind === 'calendar' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <line x1={14 + i * 22} y1="14" x2={14 + i * 22} y2="106" stroke="var(--tile-fg)" stroke-opacity=".18" />)}
      {[0, 1, 2, 3, 4].map((i) => <line x1="14" y1={14 + i * 23} x2="146" y2={14 + i * 23} stroke="var(--tile-fg)" stroke-opacity=".18" />)}
      <rect x="38" y="40" width="40" height="30" rx="4" fill="var(--pa)" transform="rotate(-6 58 55)" />
      <rect x="104" y="62" width="18" height="24" rx="3" fill="var(--tile-fg)" opacity=".5" />
    </svg>
  )}
  {kind === 'booking' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      {[0, 1, 2].map((i) => <g><circle cx={34 + i * 46} cy="60" r="18" fill={i < 2 ? 'var(--pa)' : 'none'} stroke="var(--pa)" stroke-width="4" /><text x={34 + i * 46} y="66" text-anchor="middle" font-size="16" font-family="monospace" fill={i < 2 ? 'var(--tile-bg)' : 'var(--pa)'}>{i + 1}</text></g>)}
      <line x1="52" y1="60" x2="62" y2="60" stroke="var(--pa)" stroke-width="4" /><line x1="98" y1="60" x2="108" y2="60" stroke="var(--pa)" stroke-width="4" />
    </svg>
  )}
  {kind === 'dashboard' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      <text x="14" y="78" font-size="64" font-family="Inter Tight, Arial, sans-serif" font-weight="800" fill="var(--tile-fg)">42</text>
      <path d="M100 92 A 36 36 0 1 1 148 60" fill="none" stroke="var(--tile-fg)" stroke-opacity=".25" stroke-width="8" stroke-linecap="round" />
      <path d="M100 92 A 36 36 0 0 1 118 34" fill="none" stroke="var(--pa)" stroke-width="8" stroke-linecap="round" />
    </svg>
  )}
  {kind === 'reader' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      <rect x="40" y="14" width="80" height="10" rx="2" fill="var(--tile-fg)" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="40" y={34 + i * 11} width={i === 6 ? 44 : 80} height="5" rx="2.5" fill="var(--tile-fg)" opacity=".55" />)}
      <rect x="40" y="56" width="3" height="16" fill="var(--pa)" />
    </svg>
  )}
  {kind === 'departures' && (
    <svg viewBox="0 0 160 120" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <g><rect x="14" y={16 + i * 24} width="26" height="12" rx="2" fill="var(--pa)" opacity={i === 0 ? 1 : 0.5} /><rect x="48" y={19 + i * 24} width={60 - i * 6} height="6" rx="3" fill="var(--tile-fg)" opacity=".8" /><text x="146" y={28 + i * 24} text-anchor="end" font-size="12" font-family="monospace" fill="var(--tile-fg)">{i === 0 ? 'now' : `${i * 4} min`}</text></g>)}
    </svg>
  )}
</figure>
