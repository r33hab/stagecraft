---
import Base from '../layouts/Base.astro';
import { repo, questions, doors, version, directions, reel } from '../data/site';
import compare from '../data/compare.json';
import { getImage } from 'astro:assets';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const story = compare.demos.find((d) => d.id === 'story')!.skill.metrics;
const drives = ['the story shape and the end action', 'the stack: static files, a CMS, or their codebase', 'the tier ladder and the budget', 'the direction: type, colour and motion signature', 'which device gets the full version'];
const install = '/plugin install stagecraft --marketplace r33hab/stagecraft';
// The pairs behind the dive: the same brief built with and without the skill, with the numbers the suite measured.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.jpg', { eager: true });
const still = async (name: string) => (await getImage({ src: shots[`../assets/shots/${name}.jpg`].default, width: 1120, format: 'webp', quality: 74 })).src;
const pairs = await Promise.all(reel.map(async (r) => {
  const d = compare.demos.find((x) => x.id === r.slug)!;
  const row = (m: typeof d.skill.metrics) => [m.testsPassed.replace(/ /g, ''), String(m.axeSerious), `${(m.lcpMs / 1000).toFixed(1)} s`];
  return { slug: r.slug, title: r.title, kind: r.kind, skill: row(d.skill.metrics), base: row(d.baseline.metrics), caught: d.baseline.caught, failed: ((m) => +m[1] - +m[0])(d.baseline.metrics.testsPassed.split('/').map((x) => x.trim())), total: d.baseline.metrics.testsPassed.split('/')[1].trim(), img: { skill: await still(d.skill.shot), base: await still(d.baseline.shot) } };
}));
const measured = ['Suite checks passed', 'Serious accessibility faults', 'Largest paint, slow phone'];
const production = [
  ['The bar', 'For a cinematic or 3D brief it first collects frames from the sites yours should stand next to, and writes down what they share.'],
  ['The route', 'Each scene gets the production it needs: a real model, a render, generated footage, or type alone. Live 3D is kept for what you operate.'],
  ['The gates', 'You see one style frame, then one finished scene, each beside a reference. Nothing else is built until you say yes.'],
];
const prompts = ['build me a launch page for …', 'stagecraft variations 3', 'stagecraft audit https://…', 'stagecraft test'];
---
<Base title="stagecraft · a Claude Code skill" description="stagecraft is a Claude Code skill that directs and builds animated, scroll-driven websites and tests them like software: performance, accessibility, motion and reading time, in five browsers." slug="home">
  <div class="journey" data-journey>
  <div class="journey__stage" data-journey-stage data-stage>
  <section class="hero chapter" aria-labelledby="hero-title" data-journey-hero>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__copy" data-journey-copy>
      <p class="label" data-reveal>A Claude Code skill · v{version}</p>
      <h1 class="hero__title" id="hero-title" data-reveal data-reveal-group>
        <span class="line"><span class="line__inner">Websites</span></span>
        <span class="line"><span class="line__inner">that look</span></span>
        <span class="line"><span class="line__inner">directed.</span></span>
      </h1>
      <p class="lede" data-reveal style="margin-top:1.25rem">Ask Claude Code for a site in plain words. stagecraft picks a direction, choreographs the scroll, and proves the result with a Playwright suite in five browsers: speed, accessibility, motion and reading time.</p>
      <div class="cmd" data-reveal>
        <code class="cmd__t">{install}</code>
        <button class="cmd__b" type="button" data-copy={install} aria-label="Copy the install command">Copy</button>
      </div>
      <div class="hero__actions" data-reveal>
        <a class="pill" href={`${base}/compare/`}>See it compared</a>
        <a class="pill pill--ghost" href={repo} rel="noopener">View on GitHub</a>
      </div>
    </div>

    <div class="build" data-build data-dynamic aria-hidden="true">
      <div class="build__slot" data-build-slot>
      <div class="build__frame" data-build-frame data-pv="night" data-dynamic aria-hidden="true">
        <div class="build__scene" data-build-scene>
        <div class="build__page bn" data-build-page>
          <div class="bn__sky" aria-hidden="true"><i class="bn__studio" data-bn-studio></i><img class="bn__poster" src={`${base}/kino/poster.jpg`} alt="" width="1500" height="1200" loading="lazy" decoding="async" /><canvas class="bn__world" data-bn-world data-src={base}></canvas><i class="bn__edge" data-bn-edge></i></div>
          <div class="bn__top" data-build-block><span class="bn__brand">Halde 8</span><span class="bn__times">{['Story', 'Turret', 'Film', 'Order'].map((t) => <span>{t}</span>)}</span></div>
          <div class="bn__hud" data-build-block><span>Model 1958 · 8 mm</span><span class="bn__clock" data-bn-clock>FT 00</span></div>
          <div class="bn__copy" data-build-block>
            <p class="bn__title"><span class="bp__bars" data-build-bars><i></i></span><span class="bp__w bn__swap"><i data-build-word>Restored</i><i data-bn-next>Rolling</i></span></p>
            <p class="bn__text"><span class="bp__bars bn__lines" data-bn-lines><i></i><i></i><i></i></span><span class="bn__t bn__swap"><span data-bn-text>A cine camera from 1958, taken apart and rebuilt by hand, one at a time.</span><span data-bn-next-text>Three lenses on a turret: wide, normal and tele. Wind it, turn to the shot, press.</span></span></p>
          </div>
          <ol class="bn__rail" data-build-block>{[0, 1, 2, 3, 4, 5].map((i) => <li data-bn-dot class={i === 0 ? 'is-on' : ''}></li>)}</ol>
        </div>
        <div class="build__brief" data-build-brief><span class="build__k">Brief</span><p>"The story of a restored 1958 cine camera, and a waiting list for the first twelve. Cinematic; most people will see it on a computer."</p></div>
        <ul class="build__q" data-build-q><li>Story</li><li>A developer</li><li>Cinematic</li><li>Computer</li></ul>
        <p class="build__console" data-build-console>{['smoke', 'responsive', 'a11y', 'motion', 'perf'].map((s) => <span data-build-tick>{s}</span>)}</p>
        </div>
        <div class="build__pv" data-build-pv>
          <div class="pv pv--reel" data-reel>
            {reel.map((r, i) => (
              <figure class="reel__item" data-reel-item={i}>
                <img src={`${base}/reel/${r.slug}.jpg`} alt="" loading="lazy" decoding="async" width="960" height="768" />
                <video muted playsinline loop preload="none" data-film={`${base}/reel/${r.slug}`}></video>
              </figure>
            ))}
          </div>
          <div class="pv pv--method"><p class="pv__tag"><b>Method</b> <span data-pv-step>01 Brief</span></p></div>
          <div class="pv pv--directions">
            <div class="ring" data-ring>{directions.map((d, i) => (
              <div class="ring__card" style={`--i:${i};--c-bg:${d.bg};--c-fg:${d.fg};--c-ac:${d.accent}`}>
                <span class="ring__n">{String(i + 1).padStart(2, '0')} / 16</span>
                <b class="ring__name">{d.name}</b>
                <p class="ring__s" data-face={d.face} data-caps={String(d.caps)} style={`font-weight:${d.weight}`}>{d.sample}</p>
                <span class="ring__sw"><i></i><i></i><i></i></span>
              </div>
            ))}</div>
            <p class="pv__tag"><b>Directions</b> Sixteen recipes, each with its own type, colour and motion</p>
          </div>
          <div class="pv pv--suite">
            <i class="suite__scan"></i>
            <span class="suite__box" data-suite-box=".bn__title"><em>Title · held 1.57 vp</em></span>
            <span class="suite__box" data-suite-box=".bn__text"><em>Copy · held 1.57 vp</em></span>
            <span class="suite__box" data-suite-box=".bn__clock"><em>CLS {story.cls}</em></span>
            <p class="suite__bar">{['chromium', 'webkit', 'firefox', 'mobile-low', 'reduced', `axe ${story.axeSerious} serious`].map((b) => <span>{b}</span>)}<b>{story.testsPassed.replace(/ /g, '')}</b></p>
            <p class="suite__meta">LCP {(story.lcpMs / 1000).toFixed(1)} s on a throttled phone · frame p95 {story.frameP95} ms</p>
          </div>
          <div class="pv pv--compare" data-cmp>
            <p class="cmpv__title" data-cmp-title>One Night of Light</p>
            {['skill', 'base'].map((arm) => (
              <figure class={`cmpv__arm cmpv__arm--${arm}`}>
                <video muted playsinline loop preload="none" data-cmp-film={arm}></video>
                <figcaption>{arm === 'skill' ? 'With stagecraft' : 'Without'}</figcaption>
                <dl class="cmpv__m" data-cmp-m={arm}></dl>
              </figure>
            ))}
            <p class="pv__tag"><b>Compare</b> One brief, built twice, measured by the same suite</p>
            <script type="application/json" data-cmp-data set:html={JSON.stringify(reel.map((r) => { const d = compare.demos.find((x) => x.id === r.slug)!; const m = (x: typeof d.skill.metrics) => [['Suite', x.testsPassed.replace(/ /g, '')], ['axe, serious', String(x.axeSerious)], ['LCP, slow phone', `${(x.lcpMs / 1000).toFixed(1)} s`], ['Reduced motion', x.reducedMotion ? 'handled' : 'ignored']]; return { skill: m(d.skill.metrics), base: m(d.baseline.metrics) }; }))}></script>
          </div>
        </div>
      </div>
      </div>
      <ol class="build__steps" data-build-steps data-dynamic><li>Brief</li><li>Intake</li><li>Static frame</li><li>Tokens</li><li>Choreography</li><li>Tests</li></ol>
    </div>
    <p class="scroll-cue label" aria-hidden="true">Scroll</p>
  </section>

  <p class="dive-cap" data-dive-cap><span class="label">Through the viewfinder</span><span class="dive-cap__t">One brief, built twice.</span></p>

  <section class="jq proof" id="proof" data-theme="ink" aria-labelledby="proof-title" data-journey-q data-proof>
    <div class="proof__grid">
      <div class="proof__copy">
        <div class="chapter__head" data-proof-bit><span>01 · Proof</span></div>
        <h2 class="h2" id="proof-title" data-proof-bit>Same brief. Same model. Built twice.</h2>
        <p class="lede" data-proof-bit>The only difference is the skill. On the first screen the two can look alike: drag the line to compare, then read what the same suite caught in the build without it.</p>
        <div class="proof__tabs" role="group" aria-label="Choose a brief" data-proof-bit>
          {pairs.map((p, i) => <button type="button" class="proof__tab" aria-pressed={i === 0 ? 'true' : 'false'} data-proof-tab={i}>{p.title}</button>)}
        </div>
        <table class="proof__m" data-proof-bit>
          <thead><tr><th scope="col"><span class="sr-only">Measured</span></th><th scope="col">With</th><th scope="col">Without</th></tr></thead>
          <tbody>{measured.map((m, i) => <tr><th scope="row">{m}</th><td data-proof-skill={i}>{pairs[0].skill[i]}</td><td data-proof-base={i}>{pairs[0].base[i]}</td></tr>)}</tbody>
        </table>
        <div class="cmd cmd--wide" data-proof-bit>
          <code class="cmd__t">{install}</code>
          <button class="cmd__b" type="button" data-copy={install} aria-label="Copy the install command">Copy</button>
        </div>
        <a class="link-arrow" href={`${base}/compare/`} data-proof-bit>All three pairs, every number</a>
      </div>
      <div class="proof__show">
      <div class="ba" data-ba data-proof-bit style="--ba:50%">
        {['base', 'skill'].map((arm) => (
          <figure class={`ba__side ba__side--${arm}`}>
            <img alt="" width="1120" height="700" decoding="async" data-ba-img={arm} data-thumb={pairs[0].img[arm as 'skill' | 'base']} />
          </figure>
        ))}
        <span class="ba__half ba__half--l"><span class="ba__tag ba__tag--l">With stagecraft</span></span>
        <span class="ba__half ba__half--r"><span class="ba__tag ba__tag--r">Without</span></span>
        <i class="ba__line" aria-hidden="true"><b></b></i>
        <input class="ba__range" type="range" min="0" max="100" value="50" step="1" aria-label="Move the line: left shows less of the build with stagecraft, right shows more" data-ba-range />
      </div>
      <div class="proof__caught" data-proof-bit>
        <p class="proof__k">Caught without the skill · <span data-proof-failed>{pairs[0].failed} of {pairs[0].total}</span> checks failed</p>
        <ul data-proof-caught>{pairs[0].caught.map((c) => <li>{c}</li>)}</ul>
      </div>
      </div>
    </div>
    <script type="application/json" data-proof-data set:html={JSON.stringify(pairs)}></script>
  </section>

  <section class="jd chapter doors" id="inside" aria-labelledby="doors-title" data-journey-doors>
    <div class="jd__grid">
      <div class="jd__copy">
        <div class="chapter__head"><span>02 · Built with it</span></div>
        <h2 class="h2" id="doors-title">Open the sites it built</h2>
        <p class="lede" style="margin-bottom:1.5rem">Three briefs, each built by the skill and held to the same suite. Then four doors into how it works.</p>
        <ul class="doors__list">
          {doors.map((d, i) => (
            <li>
              <a class="door" href={`${base}/${d.slug}/`} data-door={d.slug}>
                <span class="door__n">0{i + 1}</span>
                <span class="door__name" transition:name={`door-${d.slug}`}>{d.name}</span>
                <span class="door__promise">{d.promise}</span>
                <span class="door__meta">{d.meta}</span>
                <span class="door__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="jd__show">
        <div class="jd__deck" aria-hidden="true"><div class="jd__slot" data-dock-slot></div></div>
        <div class="ex">
          <p class="label ex__k">Sites it built · same suite, same budgets</p>
          <ol class="ex__list">
            {reel.map((r, i) => (
              <li class="ex__item" data-reel-go={i}>
                <a href={`${base}/${r.path}`} data-astro-reload data-astro-prefetch="false"><img class="ex__thumb" data-thumb={`${base}/reel/${r.slug}-card.jpg`} alt="" width="960" height="768" /><span class="ex__n">0{i + 1}</span><span class="ex__name">{r.title}</span><span class="ex__kind">{r.kind}</span><span class="ex__arrow" aria-hidden="true">↗</span></a>
                <i class="ex__bar" aria-hidden="true"><b></b></i>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
  </div>
  </div>

  <div class="strip marquee" data-dynamic>
    <button class="marquee-pause" type="button" aria-pressed="false" data-marquee-pause>Pause</button>
    <div class="marquee__track" aria-hidden="true">{[0, 1].map(() => ['Intake', 'Concept', 'Page map', 'Stack', 'Tokens', 'Story', 'Static frame', 'Motion', 'Tiering', 'Tests', 'Critique'].map((s) => <span>{s}</span>))}</div>
    <span class="sr-only">The flow: intake, concept, page map, stack, tokens, story, static frame, motion, tiering, tests, critique.</span>
  </div>

  <section class="chapter how" id="how" aria-labelledby="how-title">
    <div class="chapter__head"><span>03 · How it works</span></div>
    <div class="how__head">
      <h2 class="h2" id="how-title" data-reveal>Five questions nobody can answer wrong</h2>
      <p class="lede" data-reveal>They ask about your situation, never about tools. The answers decide the stack, the direction and how far the motion goes; the skill then says its choice in one sentence and builds.</p>
    </div>
    <ol class="how__qs" data-reveal data-reveal-group>
      {questions.map((q, i) => (
        <li class="how__q">
          <span class="how__n">0{i + 1}</span>
          <h3 class="how__t">{q.q}</h3>
          <ul class="q__list">{q.a.map((a) => <li>{a}</li>)}</ul>
          <p class="how__d"><span class="label">Decides</span> {drives[i]}</p>
        </li>
      ))}
    </ol>
    <div class="how__prod" data-reveal data-reveal-group>
      <p class="label how__k">New in {version} · for cinematic and 3D briefs</p>
      <ul class="how__cards">
        {production.map(([k, t]) => <li><h3 class="how__t">{k}</h3><p>{t}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="chapter" id="install" data-theme="ink" aria-labelledby="install-title">
    <div class="ticks" aria-hidden="true"><i></i></div>
    <div class="chapter__head"><span>04 · Install</span></div>
    <div class="install">
      <div>
        <h2 class="h2" id="install-title" data-reveal>One command</h2>
        <p class="lede" data-reveal>Install it in Claude Code, then ask for a site in plain words. The suite can also be dropped into an existing project on its own.</p>
      </div>
      <div data-reveal data-reveal-group>
        <p class="label" style="margin-bottom:.5rem">Install the skill</p>
        <div class="cmd cmd--wide"><code class="cmd__t">{install}</code><button class="cmd__b" type="button" data-copy={install} aria-label="Copy the install command">Copy</button></div>
        <p class="label" style="margin:1.25rem 0 .5rem">Or with npx</p>
        <div class="cmd cmd--wide"><code class="cmd__t">npx skills add r33hab/stagecraft -g -a claude-code</code><button class="cmd__b" type="button" data-copy="npx skills add r33hab/stagecraft -g -a claude-code" aria-label="Copy the npx command">Copy</button></div>
        <p class="label" style="margin:1.25rem 0 .5rem">Then say</p>
        <ul class="says">
          {prompts.map((p) => <li class="cmd cmd--wide"><code class="cmd__t">{p}</code><button class="cmd__b" type="button" data-copy={p} aria-label={`Copy the prompt: ${p}`}>Copy</button></li>)}
        </ul>
        <p class="label" style="margin:1.25rem 0 .5rem">Add the suite to any project</p>
        <pre tabindex="0"><code>node ~/.claude/skills/stagecraft/scripts/add-tests.mjs . \
  --base http://localhost:4321 --preview "npm run preview" --routes "/,/work"
npm i -D @playwright/test @axe-core/playwright
npx playwright install chromium firefox webkit
npm run build &amp;&amp; npm run test:budgets &amp;&amp; npm run test:e2e</code></pre>
      </div>
    </div>
  </section>

  <div class="ending marquee" data-dynamic aria-hidden="true">
    <div class="marquee__track">{[0, 1].map(() => [0, 1, 2].map(() => <><span class="ending__a">stagecraft</span><span class="ending__b">stagecraft</span></>))}</div>
  </div>
</Base>
